# ArogyaSwift Environment Variables Configuration Example
PORT=3000
NODE_ENV=development

# Mapbox Configuration (Optional - Generous 50,000 monthly free map loads)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cm5hbWUiLCJhIjoiY2...}

# ====================================================================
# Supabase PostgreSQL Database Configuration
# ====================================================================
# 1. Supabase PostgreSQL Connection URL (Supabase > Project Settings > Database > Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase API Configuration (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=

# ====================================================================
# Google Authentication Configuration (OAuth 2.0 / Firebase Google Auth)
# ====================================================================
# 1. Google OAuth 2.0 Client ID (from Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=

# 2. Google OAuth 2.0 Client Secret (Confidential backend secret - never exposed in client bundle)
GOOGLE_CLIENT_SECRET=

# 2. Optional: Firebase Google Auth Configuration (for Firebase popup login)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Cloudflare Pages Build Settings:
# Build Command: npm run build:client
# Build Output Directory: dist/public

# Rate Limiting Configuration (Configurable Thresholds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_USER_MAX=300
